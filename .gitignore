# Python (anchored to repo root so desktop/build app-icons aren't ignored)
__pycache__/
*.py[cod]
*.egg-info/
/dist/
/build/
.eggs/
venv/
.venv/

# Environment
.env
credentials.json

# Uploads and results
uploads/*
results/*
!uploads/.gitkeep
!results/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Model cache. models/ stays ignored wholesale EXCEPT the two VietOCR config YAMLs:
# they are ~2 KB of upstream config, they belong in review (a silent change to the
# vocab string or image_max_width would change OCR output), and committing them is
# what lets a fresh checkout build without reaching vocr.vn for them. The 151.8 MB
# vgg_transformer.pth beside them stays out — `tools/fetch_vietocr_model.py` gets it.
.cache/
models/*
!models/vietocr/
models/vietocr/*
!models/vietocr/*.yml

# Per-user app settings (may contain API key)
settings.json

# Dev / build logs
*.log
dev-stdout.log
dev-stderr.log
build-package.log

# local sidecar smoke-test stderr
scratch_sidecar.err
